# kt_theme: theme files, built-in themes, theme and font resolution, applying a theme to a
# terminal and its view. Core code: no OS calls besides reading theme folders.
#
# The built-in themes are embedded: every file of src/theme/builtin/ (keepterm's own) and of
# third_party/iterm2-color-schemes/ghostty/ (curated Ghostty themes, third_party/MANIFEST.toml)
# becomes a byte array in the generated builtin_data.cpp. Adding a file re-runs CMake.

set(kt_theme_dir ${CMAKE_CURRENT_LIST_DIR})
file(GLOB kt_theme_files CONFIGURE_DEPENDS
    ${kt_theme_dir}/builtin/*.toml
    ${PROJECT_SOURCE_DIR}/third_party/iterm2-color-schemes/ghostty/*)
list(SORT kt_theme_files)

set(kt_theme_gen "// Generated by src/theme/module.cmake from the built-in theme files. Do not edit.\n")
string(APPEND kt_theme_gen "#include \"theme/builtin_data.h\"\n\nnamespace kt::theme::detail {\n\nnamespace {\n")
set(kt_theme_table "")
set(kt_theme_i 0)
foreach(f IN LISTS kt_theme_files)
    get_filename_component(kt_theme_name "${f}" NAME)
    file(READ "${f}" kt_theme_hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," kt_theme_hex "${kt_theme_hex}")
    string(APPEND kt_theme_gen "const unsigned char kFile${kt_theme_i}[] = {${kt_theme_hex}};\n")
    string(APPEND kt_theme_table "    {\"${kt_theme_name}\", kFile${kt_theme_i}, sizeof kFile${kt_theme_i}},\n")
    math(EXPR kt_theme_i "${kt_theme_i} + 1")
endforeach()
string(APPEND kt_theme_gen "\n}  // namespace\n\nconst BuiltinFile kBuiltinFiles[] = {\n${kt_theme_table}};\n")
string(APPEND kt_theme_gen "const std::size_t kBuiltinFileCount = sizeof kBuiltinFiles / sizeof kBuiltinFiles[0];\n\n")
string(APPEND kt_theme_gen "}  // namespace kt::theme::detail\n")
set(kt_theme_out ${CMAKE_CURRENT_BINARY_DIR}/kt_theme/builtin_data.cpp)
file(CONFIGURE OUTPUT ${kt_theme_out} CONTENT "${kt_theme_gen}" @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${kt_theme_files})

kt_module(kt_theme
    ${kt_theme_dir}/color.cpp
    ${kt_theme_dir}/theme.cpp
    ${kt_theme_dir}/library.cpp
    ${kt_theme_dir}/theme_set.cpp
    ${kt_theme_dir}/apply.cpp
    ${kt_theme_out})
target_link_libraries(kt_theme PUBLIC kt_config kt_view kt_vt kt_text kt_platform_core PRIVATE kt_tomlpp)

# `keepterm --theme list|show`, `keepterm --font list`.
target_sources(keepterm PRIVATE ${kt_theme_dir}/cli.cpp)
target_link_libraries(keepterm PRIVATE kt_theme kt_text_platform)
target_compile_definitions(keepterm PRIVATE KT_HAVE_THEME=1)
