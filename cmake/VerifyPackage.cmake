# Checks a release package (cmake/KeeptermPackaging.cmake) the way a user gets it:
# unpacks it into a fresh folder and checks the layout, that the binaries start from there,
# that they are stripped and that they need nothing beyond the OS.
#
#   cmake -DPACKAGE=<file> -DVERSION=<x.y.z> [-DGLIBC_MAX=2.28] [-DARCH=arm64] [-DMINOS=13.0]
#         -P cmake/VerifyPackage.cmake
#
# PACKAGE: keepterm-<OS>-<arch>.{tar.gz,deb,dmg,zip}. GLIBC_MAX (Linux): the newest glibc symbol
# version the binaries may need. KIND (linux, macos, windows) overrides the layout the file
# extension implies (the CTest check packs the macOS bundle as .tar.gz: no dmg mount needed).
# ALLOW_PDB: a Windows debug build (CTest in Debug trees) may point to its PDB.
# ARCH (macOS): the one architecture each binary must carry
# (one package per architecture).
# Every problem is listed; the script fails at the end if there was any.

cmake_minimum_required(VERSION 3.28)

if(NOT PACKAGE OR NOT EXISTS "${PACKAGE}")
    message(FATAL_ERROR "PACKAGE not found: ${PACKAGE}")
endif()
if(NOT VERSION)
    message(FATAL_ERROR "VERSION is required")
endif()

set(problems "")
macro(problem text)
    list(APPEND problems "${text}")
    message(STATUS "FAIL: ${text}")
endmacro()
macro(ok text)
    message(STATUS "ok: ${text}")
endmacro()

get_filename_component(pkg_name "${PACKAGE}" NAME)
set(work "${PACKAGE}.verify")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")

# ------------------------------------------------------------------------------ unpack
# (One MATCHES per condition: a failed MATCHES clears CMAKE_MATCH_1.)
set(top "")
if(pkg_name MATCHES "^(.+)\\.tar\\.gz$")
    set(top "${CMAKE_MATCH_1}")
elseif(pkg_name MATCHES "^(.+)\\.zip$")
    set(top "${CMAKE_MATCH_1}")
endif()
if(top)
    file(ARCHIVE_EXTRACT INPUT "${PACKAGE}" DESTINATION "${work}")
    set(root "${work}/${top}")
    if(NOT IS_DIRECTORY "${root}")
        problem("the archive has no top folder ${top}")
    endif()
    if(KIND)
        set(kind "${KIND}")
    elseif(pkg_name MATCHES "\\.zip$")
        set(kind windows)
    else()
        set(kind linux)
    endif()
elseif(pkg_name MATCHES "\\.deb$")
    set(kind linux)
    file(ARCHIVE_EXTRACT INPUT "${PACKAGE}" DESTINATION "${work}/ar")
    file(GLOB data "${work}/ar/data.tar.*")
    file(GLOB control "${work}/ar/control.tar.*")
    if(NOT data OR NOT control)
        message(FATAL_ERROR "${pkg_name}: no data.tar or control.tar inside")
    endif()
    file(ARCHIVE_EXTRACT INPUT "${data}" DESTINATION "${work}/data")
    file(ARCHIVE_EXTRACT INPUT "${control}" DESTINATION "${work}/control")
    set(root "${work}/data/usr")
    file(READ "${work}/control/control" ctl)
    string(REPLACE "." "\\." vre "${VERSION}")
    if(NOT ctl MATCHES "\nVersion: ${vre}([.+~][0-9A-Za-z.+~]*)?(-[0-9]+)?\n")
        problem("deb Version is not ${VERSION}: ${ctl}")
    endif()
    if(NOT ctl MATCHES "\nDepends: libc6")
        problem("deb Depends does not name libc6")
    endif()
    if(ctl MATCHES "Depends:[^\n]*(libstdc|libgcc|libx11)")
        problem("deb requires a library the binary carries or opens at run time")
    endif()
elseif(pkg_name MATCHES "\\.dmg$")
    set(kind macos)
    set(mnt "${work}/mnt")
    file(MAKE_DIRECTORY "${mnt}")
    execute_process(COMMAND hdiutil attach -readonly -nobrowse -noautoopen -mountpoint "${mnt}" "${PACKAGE}"
        OUTPUT_QUIET RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "hdiutil attach failed on ${PACKAGE}")
    endif()
    if(NOT IS_SYMLINK "${mnt}/Applications")
        problem("the dmg has no Applications link")
    endif()
    execute_process(COMMAND ditto "${mnt}/keepterm.app" "${work}/keepterm.app" RESULT_VARIABLE rc)
    execute_process(COMMAND hdiutil detach "${mnt}" -quiet)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "the dmg has no keepterm.app")
    endif()
    set(root "${work}")
else()
    message(FATAL_ERROR "unknown package type: ${pkg_name}")
endif()

# ------------------------------------------------------------------------------ layout
if(kind STREQUAL "linux")
    set(bin_dir "${root}/bin")
    set(exes keepterm keepterm-mcp)
    set(required bin/keepterm bin/keepterm-mcp share/applications/keepterm.desktop
        share/icons/hicolor/scalable/apps/keepterm.svg share/doc/keepterm/THIRD_PARTY_NOTICES.txt
        share/bash-completion/completions/keepterm share/fish/vendor_completions.d/keepterm.fish)
    foreach(px 16 32 48 64 128 256 512)
        list(APPEND required share/icons/hicolor/${px}x${px}/apps/keepterm.png)
    endforeach()
elseif(kind STREQUAL "macos")
    set(app "${root}/keepterm.app")
    set(bin_dir "${app}/Contents/MacOS")
    set(exes keepterm keepterm-mcp)
    set(required keepterm.app/Contents/Info.plist keepterm.app/Contents/MacOS/keepterm
        keepterm.app/Contents/MacOS/keepterm-mcp keepterm.app/Contents/Resources/keepterm.icns
        keepterm.app/Contents/Resources/THIRD_PARTY_NOTICES.txt)
else()
    set(bin_dir "${root}")
    set(exes keepterm.exe keepterm-mcp.exe)
    set(required keepterm.exe keepterm-mcp.exe THIRD_PARTY_NOTICES.txt)
endif()
foreach(f IN LISTS required)
    if(NOT EXISTS "${root}/${f}")
        problem("missing ${f}")
    endif()
endforeach()
set(notices "")
file(GLOB_RECURSE notices "${root}/*THIRD_PARTY_NOTICES.txt")
if(notices)
    list(GET notices 0 nf)
    file(READ "${nf}" ntext)
    foreach(lib freetype harfbuzz zstd sqlite pcre2)
        if(NOT ntext MATCHES "\n${lib} ")
            problem("THIRD_PARTY_NOTICES.txt does not name ${lib}")
        endif()
    endforeach()
endif()

# ------------------------------------------------------------------------------ binaries
list(GET exes 0 main_exe)
set(main "${bin_dir}/${main_exe}")
if(EXISTS "${main}")
    # Started from the unpacked folder with a minimal environment.
    execute_process(COMMAND ${CMAKE_COMMAND} -E env --unset=LD_LIBRARY_PATH --unset=DYLD_LIBRARY_PATH
            "${main}" --version
        OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc TIMEOUT 60)
    string(STRIP "${out}" out)
    if(NOT rc EQUAL 0 OR NOT out STREQUAL "keepterm ${VERSION}")
        problem("${main_exe} --version: rc=${rc} out='${out}' err='${err}'")
    else()
        ok("${main_exe} --version: ${out}")
    endif()
endif()

foreach(e IN LISTS exes)
    set(b "${bin_dir}/${e}")
    if(NOT EXISTS "${b}")
        continue()
    endif()
    if(kind STREQUAL "linux")
        execute_process(COMMAND readelf -SW "${b}" OUTPUT_VARIABLE sec)
        if(sec MATCHES "\\.symtab|\\.debug_")
            problem("${e} is not stripped")
        endif()
        execute_process(COMMAND readelf -dW "${b}" OUTPUT_VARIABLE dyn)
        string(REGEX MATCHALL "Shared library: \\[[^]]+\\]" needed "${dyn}")
        foreach(n IN LISTS needed)
            string(REGEX REPLACE "Shared library: \\[([^]]+)\\]" "\\1" n "${n}")
            if(NOT n MATCHES "^(libc|libm|libpthread|libdl|librt|ld-linux-[a-z0-9_-]+|ld-linux)\\.so\\.[0-9]+$")
                problem("${e} needs ${n}; only glibc may be shared")
            endif()
        endforeach()
        execute_process(COMMAND objdump -T "${b}" OUTPUT_VARIABLE syms)
        if(syms MATCHES "(GLIBCXX|CXXABI|GCC)_[0-9]")
            problem("${e} imports the C++ runtime")
        endif()
        if(GLIBC_MAX)
            string(REGEX MATCHALL "GLIBC_[0-9]+(\\.[0-9]+)*" vs "${syms}")
            list(REMOVE_DUPLICATES vs)
            set(newest 0)
            foreach(v IN LISTS vs)
                string(REPLACE "GLIBC_" "" v "${v}")
                if(v VERSION_GREATER newest)
                    set(newest "${v}")
                endif()
            endforeach()
            if(newest VERSION_GREATER GLIBC_MAX)
                problem("${e} needs GLIBC_${newest}, more than ${GLIBC_MAX}")
            else()
                ok("${e} needs at most GLIBC_${newest}")
            endif()
        endif()
    elseif(kind STREQUAL "macos")
        execute_process(COMMAND nm -ap "${b}" OUTPUT_VARIABLE nmout ERROR_QUIET)
        if(nmout MATCHES " (SO|OSO|FUN|SOL) ")
            problem("${e} is not stripped (debug map entries)")
        endif()
        execute_process(COMMAND otool -L "${b}" OUTPUT_VARIABLE libs)
        string(REPLACE "\n" ";" libs "${libs}")
        foreach(l IN LISTS libs)
            if(l MATCHES "^\t([^ ]+) ")
                if(NOT CMAKE_MATCH_1 MATCHES "^(/System/Library/|/usr/lib/)")
                    problem("${e} loads ${CMAKE_MATCH_1}")
                endif()
            endif()
        endforeach()
        execute_process(COMMAND lipo -archs "${b}" OUTPUT_VARIABLE archs OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(ARCH AND NOT archs STREQUAL ARCH)
            problem("${e} carries '${archs}', expected ${ARCH}")
        endif()
        if(MINOS)
            execute_process(COMMAND otool -l "${b}" OUTPUT_VARIABLE lc)
            string(REGEX MATCHALL "minos [0-9.]+" found "${lc}")
            foreach(m IN LISTS found)
                string(REPLACE "minos " "" v "${m}")
                if(v VERSION_GREATER MINOS)
                    problem("${e} needs macOS ${v}, more than ${MINOS}")
                endif()
            endforeach()
        endif()
        ok("${e}: ${archs}")
    else()
        # Static CRT: no VC++ or UCRT DLL. dumpbin comes with MSVC (vcvars on PATH).
        find_program(DUMPBIN dumpbin)
        if(DUMPBIN)
            execute_process(COMMAND "${DUMPBIN}" /nologo /dependents "${b}" OUTPUT_VARIABLE deps)
            string(TOLOWER "${deps}" deps)
            if(deps MATCHES "(vcruntime|msvcp|ucrtbase|api-ms-win-crt)[^\n]*\\.dll")
                problem("${e} needs the VC++ runtime: ${CMAKE_MATCH_0}")
            endif()
            execute_process(COMMAND "${DUMPBIN}" /nologo /headers "${b}" OUTPUT_VARIABLE hdr)
            if(NOT ALLOW_PDB AND hdr MATCHES "Debug Directories[^\n]*\n[^\n]*\n[^\n]*\n[^\n]*cv[^\n]*\\.pdb")
                problem("${e} points to a PDB (not a release build)")
            endif()
            ok("${e}: static CRT")
        else()
            message(STATUS "dumpbin not found: the import check of ${e} is skipped")
        endif()
    endif()
endforeach()

# ------------------------------------------------------------------------------ macOS bundle
if(kind STREQUAL "macos" AND EXISTS "${app}/Contents/Info.plist")
    foreach(kv "CFBundleExecutable=keepterm" "CFBundleIconFile=keepterm" "CFBundleShortVersionString=${VERSION}"
            "CFBundlePackageType=APPL")
        string(REPLACE "=" ";" kv "${kv}")
        list(GET kv 0 k)
        list(GET kv 1 want)
        execute_process(COMMAND plutil -extract ${k} raw -o - "${app}/Contents/Info.plist"
            OUTPUT_VARIABLE got OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT got STREQUAL want)
            problem("Info.plist ${k}='${got}', expected '${want}'")
        endif()
    endforeach()
    if(MINOS)
        execute_process(COMMAND plutil -extract LSMinimumSystemVersion raw -o - "${app}/Contents/Info.plist"
            OUTPUT_VARIABLE got OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT got STREQUAL MINOS)
            problem("LSMinimumSystemVersion='${got}', expected ${MINOS}")
        endif()
    endif()
    execute_process(COMMAND codesign --verify --deep --strict "${app}" ERROR_VARIABLE err RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        problem("codesign --verify: ${err}")
    else()
        ok("keepterm.app signature is valid")
    endif()
endif()

file(REMOVE_RECURSE "${work}")
if(problems)
    list(LENGTH problems n)
    message(FATAL_ERROR "${pkg_name}: ${n} problem(s)")
endif()
message(STATUS "${pkg_name}: ok")
