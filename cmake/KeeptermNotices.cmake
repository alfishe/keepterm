# THIRD_PARTY_NOTICES.txt: every third_party/MANIFEST.toml entry with
# `linked = true`, with its version, license and the full license text. Shipped in every package.

function(kt_generate_notices out)
    set(manifest "${PROJECT_SOURCE_DIR}/third_party/MANIFEST.toml")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    file(STRINGS "${manifest}" lines)
    set(names "")
    set(cur "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^\\[([^]]+)\\]")
            set(cur "${CMAKE_MATCH_1}")
            list(APPEND names "${cur}")
        elseif(cur AND line MATCHES "^(version|license|license_file|linked) *= *(.*)$")
            set(key "${CMAKE_MATCH_1}")
            set(value "${CMAKE_MATCH_2}")
            if(value MATCHES "^\"([^\"]*)\"")         # a quoted string; a comment may follow
                set(value "${CMAKE_MATCH_1}")
            elseif(value MATCHES "^([a-z]+)")          # true / false
                set(value "${CMAKE_MATCH_1}")
            endif()
            set(kt_n_${cur}_${key} "${value}")
        endif()
    endforeach()

    set(text "keepterm ${PROJECT_VERSION} includes the following third-party software.\n")
    set(count 0)
    foreach(n IN LISTS names)
        if(NOT kt_n_${n}_linked STREQUAL "true")
            continue()
        endif()
        set(file "${PROJECT_SOURCE_DIR}/third_party/${kt_n_${n}_license_file}")
        if(NOT kt_n_${n}_license_file OR NOT EXISTS "${file}")
            message(FATAL_ERROR "MANIFEST.toml: ${n} has no license file (${file})")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" body)
        string(REPEAT "=" 78 rule)
        string(APPEND text "\n${rule}\n${n} ${kt_n_${n}_version}\nLicense: ${kt_n_${n}_license}\n${rule}\n\n${body}\n")
        math(EXPR count "${count} + 1")
    endforeach()
    if(count EQUAL 0)
        message(FATAL_ERROR "MANIFEST.toml: no linked entries")
    endif()
    file(CONFIGURE OUTPUT "${out}" CONTENT "${text}" @ONLY NEWLINE_STYLE UNIX)
endfunction()
